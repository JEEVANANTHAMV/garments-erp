{
  "name": "garment-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:prod": "./scripts/deploy.sh",
    "deploy": "./scripts/deploy.sh",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "dev": "npm --prefix server run dev & npm --prefix web run dev",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset",
    "build:server": "npm --prefix server run build",
    "build:web": "npm --prefix web run build",
    "build": "npm --prefix server run build && npm --prefix web run build"
  }
}
